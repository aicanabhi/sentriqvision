# Application
APP_NAME=SentriqVision
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentriqvision
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# OTP
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sentriqvision.com
SMTP_FROM_NAME=SentriqVision
SMTP_TLS=true

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
SNAPSHOT_DIR=uploads/snapshots
VIDEO_DIR=uploads/videos
THUMBNAIL_DIR=uploads/thumbnails

# AI Engine
AI_MODEL_DIR=models
AI_CONFIDENCE_THRESHOLD=0.5
AI_FRAME_SKIP=2
MAX_CONCURRENT_STREAMS=10

# Camera
RTSP_TIMEOUT_SECONDS=10
CAMERA_RECONNECT_INTERVAL=5
FRAME_BUFFER_SIZE=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Super Admin (seed)
SUPER_ADMIN_EMAIL=admin@sentriqvision.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=Super Admin

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
